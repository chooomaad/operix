# Variables de l'Edge Function `api`.
#
# EN LOCAL : copier ce fichier en supabase/functions/.env (jamais commité) ;
#            `npx supabase functions serve` le lit automatiquement.
# EN LIGNE : npx supabase secrets set ANTHROPIC_API_KEY=... OPERIX_AI_MODEL=claude-opus-5-5
#
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY et SUPABASE_DB_URL sont fournis
# automatiquement par Supabase : ne pas les définir.

# Vide = moteur de règles (certitude plafonnée à 70 %, signalé « rules » dans l'app).
ANTHROPIC_API_KEY=
OPERIX_AI_MODEL=claude-opus-5-5

# LOCAL UNIQUEMENT : adresse à laquelle le téléphone joint Supabase, pour les liens
# des photos. Avec `adb reverse tcp:54321 tcp:54321`, le téléphone voit le PC en localhost.
# À laisser vide en production.
OPERIX_PUBLIC_URL=http://localhost:54321
