{
  "expo": {
    "name": "OPERIX",
    "slug": "operix-mobile",
    "scheme": "operix",
    "version": "1.0.0",
    "icon": "./assets/operix-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FC",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/operix-logo.png",
          "backgroundColor": "#F7F8FC",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OPERIX utilise la caméra pour photographier les preuves terrain."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OPERIX accède à vos photos pour joindre une preuve à une déclaration."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OPERIX géolocalise les événements déclarés."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Connexion biométrique OPERIX."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "OPERIX transcrit votre constat vocal.",
          "speechRecognitionPermission": "OPERIX transcrit votre constat vocal."
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.operix.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FC",
        "foregroundImage": "./assets/operix-adaptive-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.operix.hsse",
      "supportsTablet": false,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "OPERIX transcrit votre constat vocal.",
        "NSMicrophoneUsageDescription": "OPERIX transcrit votre constat vocal."
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://vnsuwwglgbqumizqsvoy.supabase.co/functions/v1/api/v1",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c8653c6b-fc83-4fd5-9864-fbec5721bcf2"
      }
    }
  }
}
